# Normalize line endings on commit; check out native.
* text=auto

# Explicit types for files where auto-detection is unhelpful.
*.md       text diff=markdown
*.json     text
*.sh       text eol=lf
*.ts       text diff=typescript
*.tsx      text diff=typescript
*.py       text diff=python

# Map authoring formats: plain text (XML / JSON respectively), diffable.
*.tmx      text
*.ldtk     text

# Binary — never diff or normalize.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.woff      binary
*.woff2     binary
*.mp3       binary
*.mp4       binary
*.aseprite  binary
*.ogg       binary
*.wav       binary

# Upstream and machine-derived datasets: not our code, so they are kept out of
# GitHub language statistics. Authored content under content/ is deliberately
# absent from this list — it is our writing and should count.
Data/**/*.json  linguist-vendored
data/**/*.json  linguist-vendored

# The raw upstream dump is never reviewed by hand. linguist-vendored alone does
# not suppress diffs, so say so explicitly.
Data/DanielCREFs/daniel-cross-references_*.json  -diff
